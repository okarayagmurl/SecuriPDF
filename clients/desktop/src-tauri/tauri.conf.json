{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecuriPDF",
  "version": "1.2.53",
  "identifier": "net.entera.securipdf.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "engine/": "engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "both"
      }
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "SecuriPDF PDF",
        "description": "SecuriPDF belgesi",
        "role": "Viewer"
      }
    ]
  }
}
